          <div>
            <strong>
              🎵 {musicTracks.find((track) => track.id === currentAudio)?.title}
            </strong>
            <small>
              {" • "}
              {musicTracks.find((track) => track.id === currentAudio)?.artist}
            </small>
          </div>

          <button
            onClick={() => {
              if (audioElement.paused) audioElement.play();
              else audioElement.pause();
              setAudioElement(audioElement);
            }}
          >
            {audioElement.paused ? "▶ Play" : "⏸ Pause"}
          </button>

          <button onClick={stopMusic}>⏹ Stop</button>
        </div>
      )}

      {callOpen && (
        <div className="call-screen">
          {callType === "video" ? (
            <video
              ref={videoRef}
              className="call-video"
              autoPlay
              playsInline
              muted
            />
          ) : (
            <div className="audio-call-screen">
              <div className="call-avatar">👤</div>
              <h2>AP-STREAM Audio Call</h2>
              <p>Microphone connected</p>
            </div>
          )}

          <div className="call-top">
            <span>
              {callType === "video" ? "📹 HD Video Call" : "📞 Audio Call"}
            </span>
          </div>

          <div className="call-controls">
            <button onClick={toggleMic}>
              {micOn ? "🎙️ Mute" : "🔇 Unmute"}
            </button>

            {callType === "video" && (
              <>
                <button onClick={toggleCamera}>
                  {cameraOn ? "📷 Camera Off" : "📷 Camera On"}
                </button>

                <button onClick={switchCamera}>🔄 Switch Camera</button>
              </>
            )}

            <button className="end-call" onClick={endCall}>
              🔴 End Call
            </button>
          </div>
        </div>
      )}

      <AIAssistant />
      <AIAssistantManager />

      <footer>
        © 2026 AP-STREAM • Music • Video • Community • Calls
      </footer>
    </div>
  );
}

export default App;
