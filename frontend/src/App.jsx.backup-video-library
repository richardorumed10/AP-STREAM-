import { useRef, useState } from "react";
import "./App.css";

const songs = [
  { name: "Midnight Waves", file: "/music/midnight-waves.mp3" },
  { name: "African Pulse", file: "/music/african-pulse.mp3" },
  { name: "Test Song", file: "/music/test-song-clean.mp3" },
];

function App() {
  const [currentSong, setCurrentSong] = useState(null);
  const [videoFile, setVideoFile] = useState(null);
  const [isVideoPlaying, setIsVideoPlaying] = useState(false);

  const videoRef = useRef(null);

  const handleVideoSelect = (event) => {
    const file = event.target.files[0];

    if (file) {
      const videoUrl = URL.createObjectURL(file);
      setVideoFile(videoUrl);
      setIsVideoPlaying(false);
    }
  };

  const toggleVideo = () => {
    if (!videoRef.current) return;

    if (videoRef.current.paused) {
      videoRef.current.play();
      setIsVideoPlaying(true);
    } else {
      videoRef.current.pause();
      setIsVideoPlaying(false);
    }
  };

  const playNext = () => {
    if (!currentSong) return;

    const index = songs.findIndex(
      (song) => song.name === currentSong.name
    );

    const next = songs[(index + 1) % songs.length];
    setCurrentSong(next);
  };

  const playPrevious = () => {
    if (!currentSong) return;

    const index = songs.findIndex(
      (song) => song.name === currentSong.name
    );

    const previous =
      songs[(index - 1 + songs.length) % songs.length];

    setCurrentSong(previous);
  };

  return (
    <div className="app">

      <header>
        <h1>AP-STREAM</h1>

        <nav>
          <button>Home</button>
          <button>Music</button>
          <button
            onClick={() =>
              document
                .getElementById("videos")
                ?.scrollIntoView({ behavior: "smooth" })
            }
          >
            Videos
          </button>
          <button>Artists</button>
          <button>Login</button>
        </nav>
      </header>

      <main>

        <section className="hero">
          <p>MUSIC • VIDEO • COMMUNITY</p>

          <h2>Welcome to AP-STREAM</h2>

          <p>
            Discover music, watch videos and connect with creators.
          </p>

          <button
            onClick={() =>
              document
                .getElementById("music")
                ?.scrollIntoView({ behavior: "smooth" })
            }
          >
            Start Listening
          </button>

          <button
            onClick={() =>
              document
                .getElementById("videos")
                ?.scrollIntoView({ behavior: "smooth" })
            }
          >
            Explore Videos
          </button>
        </section>

        {/* MUSIC */}

        <section id="music" className="music-section">

          <h2>🎵 Trending Music</h2>

          <div className="music-grid">

            {songs.map((song) => (
              <div className="music-card" key={song.name}>

                <div className="music-icon">♫</div>

                <h3>{song.name}</h3>

                <p>AP Artist</p>

                <button
                  onClick={() => setCurrentSong(song)}
                >
                  ▶ Play
                </button>

              </div>
            ))}

          </div>

        </section>

        {/* VIDEO */}

        <section id="videos" className="video-section">

          <h2>🎬 AP-STREAM Video Player</h2>

          <div className="video-player-container">

            {videoFile ? (
              <>
                <video
                  ref={videoRef}
                  src={videoFile}
                  controls
                  playsInline
                  onPlay={() => setIsVideoPlaying(true)}
                  onPause={() => setIsVideoPlaying(false)}
                  onEnded={() => setIsVideoPlaying(false)}
                />

                <div className="video-controls">

                  <button onClick={toggleVideo}>
                    {isVideoPlaying ? "⏸ Pause" : "▶ Play"}
                  </button>

                  <button
                    onClick={() => {
                      if (videoRef.current) {
                        videoRef.current.currentTime = 0;
                        videoRef.current.play();
                        setIsVideoPlaying(true);
                      }
                    }}
                  >
                    🔄 Restart
                  </button>

                </div>
              </>
            ) : (
              <div className="video-placeholder">

                <div className="big-play">▶</div>

                <h3>No video selected</h3>

                <p>
                  Choose a video from your phone to start watching.
                </p>

              </div>
            )}

            <div className="video-upload">

              <label htmlFor="video-upload">
                📁 Choose Video
              </label>

              <input
                id="video-upload"
                type="file"
                accept="video/*"
                onChange={handleVideoSelect}
              />

            </div>

          </div>

        </section>

        {/* FEATURED VIDEOS */}

        <section className="video-section">

          <h2>🔥 Featured Videos</h2>

          <div className="video-grid">

            <div className="video-card">
              <div className="video-placeholder">▶</div>
              <h3>AP-STREAM Video 1</h3>
              <p>Upload a video to watch it here.</p>
            </div>

            <div className="video-card">
              <div className="video-placeholder">▶</div>
              <h3>AP-STREAM Video 2</h3>
              <p>Upload a video to watch it here.</p>
            </div>

            <div className="video-card">
              <div className="video-placeholder">▶</div>
              <h3>AP-STREAM Video 3</h3>
              <p>Upload a video to watch it here.</p>
            </div>

          </div>

        </section>

        {/* MUSIC PLAYER */}

        {currentSong && (

          <div className="player">

            <div className="player-art">
              ♫
            </div>

            <div className="player-info">

              <span>NOW PLAYING</span>

              <strong>
                {currentSong.name}
              </strong>

              <small>
                AP Artist
              </small>

            </div>

            <div className="player-actions">

              <button
                onClick={playPrevious}
                aria-label="Previous song"
              >
                ⏮
              </button>

              <button
                onClick={playNext}
                aria-label="Next song"
              >
                ⏭
              </button>

            </div>

            <div className="player-audio">

              <audio
                controls
                autoPlay
                src={currentSong.file}
              >
                Your browser does not support audio.
              </audio>

            </div>

          </div>

        )}

      </main>

      <footer>
        © 2026 AP-STREAM
      </footer>

    </div>
  );
}

export default App;
