function App() {
  const [currentAudio, setCurrentAudio] = useState(null);
  const [audioElement, setAudioElement] = useState(null);
  const [posts, setPosts] = useState(initialPosts);
  const [newPost, setNewPost] = useState("");
  const [commentText, setCommentText] = useState({});
  const [showLoginMessage, setShowLoginMessage] = useState(false);
  const [footballTab, setFootballTab] = useState("home");

  const [newsCategory, setNewsCategory] = useState("all");
  const [newsSearch, setNewsSearch] = useState("");


  const [callOpen, setCallOpen] = useState(false);
  const [callType, setCallType] = useState(null);
  const [micOn, setMicOn] = useState(true);
  const [cameraOn, setCameraOn] = useState(true);
  const [facingMode, setFacingMode] = useState("user");
  const [callError, setCallError] = useState("");

  const videoRef = useRef(null);
  const streamRef = useRef(null);

  function playMusic(track) {
    if (currentAudio === track.id && audioElement) {
      if (audioElement.paused) audioElement.play();
      else audioElement.pause();
      setAudioElement(audioElement);
      return;
    }

    if (audioElement) audioElement.pause();

    const audio = new Audio(track.file);

    audio.onended = () => {
      const index = musicTracks.findIndex((item) => item.id === track.id);
      const nextTrack = musicTracks[index + 1];

      if (nextTrack) playMusic(nextTrack);
      else {
        setCurrentAudio(null);
        setAudioElement(null);
      }
    };

    audio.play().catch((error) => console.error("Audio playback failed:", error));

    setAudioElement(audio);
    setCurrentAudio(track.id);
  }

  function stopMusic() {
    if (audioElement) {
      audioElement.pause();
      audioElement.currentTime = 0;
    }
    setCurrentAudio(null);
    setAudioElement(null);
  }

  function toggleLike(postId) {
    setPosts((currentPosts) =>
      currentPosts.map((post) =>
        post.id === postId
          ? {
              ...post,
              liked: !post.liked,
              likes: post.liked ? post.likes - 1 : post.likes + 1,
            }
          : post
      )
    );
  }

  function createPost() {
    const text = newPost.trim();
    if (!text) return;

    const post = {
      id: Date.now(),
      artist: "AP User",
      time: "Just now",
      text,
      likes: 0,
      liked: false,
      comments: [],
    };

    setPosts((currentPosts) => [post, ...currentPosts]);
    setNewPost("");
  }

  function addComment(postId) {
    const text = (commentText[postId] || "").trim();
    if (!text) return;

    setPosts((currentPosts) =>
      currentPosts.map((post) =>
        post.id === postId
          ? { ...post, comments: [...post.comments, text] }
          : post
      )
    );

    setCommentText((current) => ({
      ...current,
      [postId]: "",
    }));
  }

  async function sharePost(text) {
    try {
      if (navigator.share) {
        await navigator.share({ title: "AP-STREAM", text });
      } else if (navigator.clipboard) {
        await navigator.clipboard.writeText(text);
        alert("Post copied to clipboard.");
      } else {
        alert(text);
      }
    } catch {
      // Sharing cancelled.
    }
  }

  function login() {
    setShowLoginMessage(true);
  }

  async function startCall(type) {
    setCallError("");
    setCallType(type);

    try {
      const constraints =
        type === "video"
          ? {
              video: {
                width: { ideal: 1920, min: 1280 },
                height: { ideal: 1080, min: 720 },
                frameRate: { ideal: 30, max: 60 },
                facingMode,
              },
              audio: {
                echoCancellation: true,
                noiseSuppression: true,
                autoGainControl: true,
              },
            }
          : {
              audio: {
                echoCancellation: true,
                noiseSuppression: true,
                autoGainControl: true,
              },
            };

      const stream = await navigator.mediaDevices.getUserMedia(constraints);

      streamRef.current = stream;
      setCallOpen(true);

      if (type === "video" && videoRef.current) {
        videoRef.current.srcObject = stream;
      }
    } catch (error) {
      console.error("Call permission error:", error);
      setCallError(
        "Camera or microphone access was denied or is unavailable on this device."
      );
      setCallOpen(false);
    }
  }

  function endCall() {
    if (streamRef.current) {
      streamRef.current.getTracks().forEach((track) => track.stop());
      streamRef.current = null;
    }

    if (videoRef.current) {
      videoRef.current.srcObject = null;
    }

    setCallOpen(false);
    setCallType(null);
    setMicOn(true);
    setCameraOn(true);
  }

  function toggleMic() {
    if (!streamRef.current) return;

    streamRef.current.getAudioTracks().forEach((track) => {
      track.enabled = !track.enabled;
      setMicOn(track.enabled);
    });
  }

  function toggleCamera() {
    if (!streamRef.current) return;

    streamRef.current.getVideoTracks().forEach((track) => {
      track.enabled = !track.enabled;
      setCameraOn(track.enabled);
    });
  }

  async function switchCamera() {
    if (callType !== "video") return;

    const nextFacingMode = facingMode === "user" ? "environment" : "user";

    try {
      const oldStream = streamRef.current;

      if (oldStream) {
        oldStream.getTracks().forEach((track) => track.stop());
      }

      const newStream = await navigator.mediaDevices.getUserMedia({
        video: {
          width: { ideal: 1920 },
          height: { ideal: 1080 },
          frameRate: { ideal: 30, max: 60 },
          facingMode: nextFacingMode,
        },
        audio: {
          echoCancellation: true,
          noiseSuppression: true,
          autoGainControl: true,
        },
      });

      streamRef.current = newStream;
      setFacingMode(nextFacingMode);

      if (videoRef.current) {
        videoRef.current.srcObject = newStream;
      }
    } catch (error) {
      console.error("Camera switch failed:", error);
      setCallError("Unable to switch camera.");
    }
  }


  const filteredNews = newsItems.filter((item) => {
    const matchesCategory =
      newsCategory === "all" || item.category === newsCategory;

    const search = newsSearch.trim().toLowerCase();

    const matchesSearch =
      !search ||
      item.title.toLowerCase().includes(search) ||
      item.text.toLowerCase().includes(search) ||
      item.category.toLowerCase().includes(search);

    return matchesCategory && matchesSearch;
  });

  useEffect(() => {
    return () => {
      if (streamRef.current) {
        streamRef.current.getTracks().forEach((track) => track.stop());
      }
    };
  }, []);

  return (
    <div className="app">
      <header>
        <div className="logo">AP-STREAM</div>

        <nav>
          <a href="#home">Home</a>
          <a href="#music">Music</a>
          <a href="#videos">Videos</a>
          <a href="#football">Football</a>\n            <a href="#games">Games</a>\n            <a href="#artists">Artists</a>
          <a href="#news">News</a>
          <a href="#community">Community</a>
          <a href="#calls">Calls</a>
          <a href="#boda">🛵 Boda</a>
          <a href="#boda-rider">🛵 Rider</a>
          <a href="#boda-verification">📷 Verification</a>
          <a href="#login">Login</a>
        </nav>
      </header>

      <main>
        <Home />

        <section id="music">
          <h2>🔥 Trending Music</h2>
          <p className="section-subtitle">Fresh sounds</p>

          <div className="cards">
            {musicTracks.map((track) => (
              <div className="card" key={track.id}>
                <div className="music-icon">{track.icon}</div>
                <h3>{track.title}</h3>
                <p>{track.artist}</p>

                <button onClick={() => playMusic(track)}>
                  {currentAudio === track.id && audioElement && !audioElement.paused
                    ? "⏸ Pause"
                    : "▶ Play"}
                </button>
              </div>
            ))}
          </div>
        </section>

        <section id="videos" className="videos-hub">
          <div className="videos-header">
            <div>
              <p className="eyebrow">AP-STREAM WATCH</p>
              <h2>🎬 Videos</h2>
              <p className="section-subtitle">
                Discover music videos, creators, stories and entertainment.
              </p>
            </div>

            <a href="#videos" className="button">
              Explore Videos
            </a>
          </div>

          <div className="featured-video">
            <video controls preload="metadata">
              <source
                src="/videos/e1e2ea73-6b3d-49b1-9c6a-312777beb39b.mp4"
                type="video/mp4"
              />
              Your browser does not support video playback.
            </video>

            <div className="featured-video-info">
              <span className="video-tag">⭐ FEATURED</span>
              <h3>AP-STREAM Featured Video</h3>
              <p>
                Watch featured content from AP-STREAM artists and creators.
              </p>

              <div className="video-actions">
                <button onClick={() => alert("Video liked ❤️")}>
                  ♡ Like
                </button>
                <button onClick={() => alert("Share feature coming soon.")}>
                  ↗ Share
                </button>
              </div>
            </div>
          </div>

          <div className="video-section-heading">
            <div>
              <h3>🔥 Trending Now</h3>
              <p>Popular videos on AP-STREAM</p>
            </div>
          </div>

          <div className="video-grid">
            <article className="video-tile">
              <div className="video-thumbnail music-thumb">
                <span>🎵</span>
                <strong>PLAY</strong>
              </div>
              <div className="video-tile-info">
                <span>🎵 MUSIC</span>
                <h3>African Pulse</h3>
                <p>AP-STREAM Music</p>
              </div>
            </article>

            <article className="video-tile">
              <div className="video-thumbnail creator-thumb">
                <span>🎤</span>
                <strong>PLAY</strong>
              </div>
              <div className="video-tile-info">
                <span>🎤 CREATOR</span>
                <h3>Artist Spotlight</h3>
                <p>Meet AP-STREAM creators</p>
              </div>
            </article>

            <article className="video-tile">
              <div className="video-thumbnail culture-thumb">
                <span>🌍</span>
                <strong>PLAY</strong>
              </div>
              <div className="video-tile-info">
                <span>🌍 CULTURE</span>
                <h3>Africa Now</h3>
                <p>Stories from across Africa</p>
              </div>
            </article>
          </div>

          <div className="shorts-heading">
            <h3>⚡ AP-STREAM Shorts</h3>
            <p>Quick videos. Fresh moments.</p>
          </div>

          <div className="shorts-grid">
            <article className="short-card">
              <div>🎵</div>
              <h3>Music Moment</h3>
              <p>Fresh sounds from AP artists.</p>
              <button>▶ Watch</button>
            </article>

            <article className="short-card">
              <div>🔥</div>
              <h3>Trending Moment</h3>
              <p>What's happening on AP-STREAM.</p>
              <button>▶ Watch</button>
            </article>

            <article className="short-card">
              <div>🌍</div>
              <h3>Africa Spotlight</h3>
              <p>Creators, culture and stories.</p>
              <button>▶ Watch</button>
            </article>
          </div>
        </section>

        <section id="news" className="news-section">
          <h2>📰 AP-STREAM News</h2>

          <p className="section-subtitle">
            Uganda, Africa and world news
          </p>

          <div className="news-categories">
            <button onClick={() => setNewsCategory("all")}>📰 All</button>
            <button onClick={() => setNewsCategory("breaking")}>🚨 Breaking</button>
            <button onClick={() => setNewsCategory("uganda")}>🇺🇬 Uganda</button>
            <button onClick={() => setNewsCategory("africa")}>🌍 Africa</button>
            <button onClick={() => setNewsCategory("world")}>🌎 World</button>
            <button onClick={() => setNewsCategory("technology")}>💻 Technology</button>
            <button onClick={() => setNewsCategory("entertainment")}>🎵 Entertainment</button>
          </div>

          <div className="news-search">
            <input
              type="search"
              value={newsSearch}
              onChange={(event) => setNewsSearch(event.target.value)}
              placeholder="🔎 Search news..."
            />
            <button onClick={() => setNewsSearch(newsSearch.trim())}>
              Search
            </button>
          </div>

          <div className="news-grid">
            {filteredNews.length > 0 ? (
              filteredNews.map((item) => (
                <article
                  key={item.id}
                  className={`news-card ${
                    item.category === "breaking" ? "breaking" : ""
                  }`}
                >
                  <span className="news-label">{item.label}</span>

                  <h3>{item.title}</h3>

                  <p>{item.text}</p>

                  <a
                    href={item.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    className="button"
                  >
                    Read Article ↗
                  </a>
                </article>
              ))
            ) : (
              <div className="news-empty">
                <h3>🔎 No news found</h3>
                <p>Try another search or choose a different category.</p>
              </div>
            )}
          </div>

          <div className="news-footer">
            <p>
              🔗 AP-STREAM News links readers to original publishers
              for full articles.
            </p>
          </div>
        </section>

        <section id="community">
          <h2>🌍 Community</h2>
          <p className="section-subtitle">
            Connect with artists, creators and fans.
          </p>

          <div className="create-post">
            <textarea
              value={newPost}
              onChange={(event) => setNewPost(event.target.value)}
              placeholder="Share something with the AP-STREAM community..."
              rows="3"
            />
            <button onClick={createPost}>Post</button>
          </div>

          <div className="feed">
            {posts.map((post) => (
              <div className="post" key={post.id}>
                <div className="post-header">
                  <strong>🎤 {post.artist}</strong>
                  <small>{post.time}</small>
                </div>

                <p>{post.text}</p>

                <div className="post-actions">
                  <button onClick={() => toggleLike(post.id)}>
                    {post.liked ? "❤️ Liked" : "♡ Like"}
                    {post.likes > 0 && ` ${post.likes}`}
                  </button>

                  <button
                    onClick={() =>
                      document.getElementById(`comment-${post.id}`)?.focus()
                    }
                  >
                    💬 Comment
                  </button>

                  <button onClick={() => sharePost(post.text)}>↗ Share</button>
                </div>

                {post.comments.length > 0 && (
                  <div className="comments">
                    {post.comments.map((comment, index) => (
                      <p key={index}>
                        💬 <strong>AP User:</strong> {comment}
                      </p>
                    ))}
                  </div>
                )}

                <div className="comment-box">
                  <input
                    id={`comment-${post.id}`}
                    value={commentText[post.id] || ""}
                    onChange={(event) =>
                      setCommentText((current) => ({
                        ...current,
                        [post.id]: event.target.value,
                      }))
                    }
                    placeholder="Write a comment..."
                  />
                  <button onClick={() => addComment(post.id)}>Send</button>
                </div>
              </div>
            ))}
          </div>
        </section>

        <section id="artists" className="artists-hub">
          <div className="artists-header">
            <div>
              <p className="eyebrow">AP-STREAM CREATORS</p>
              <h2>🎤 Artists & Creators</h2>
              <p className="section-subtitle">
                Discover African artists, musicians and creators.
              </p>
            </div>

            <button onClick={() => alert("Artist registration is coming soon.")}>
              ✨ Become an Artist
            </button>
          </div>

          <div className="artist-feature">
            <div className="artist-cover">
              <div className="artist-large-avatar">🎤</div>
            </div>

            <div className="artist-feature-content">
              <span className="artist-badge">⭐ FEATURED ARTIST</span>
              <h2>AP Artist</h2>
              <p className="artist-handle">@apartist</p>

              <p>
                Music artist and creator on AP-STREAM. Discover new sounds,
                videos and upcoming releases.
              </p>

              <div className="artist-stats">
                <span><strong>2</strong> Tracks</span>
                <span><strong>1</strong> Video</span>
                <span><strong>1.2K</strong> Followers</span>
              </div>

              <div className="artist-buttons">
                <button onClick={() => alert("You are now following AP Artist ❤️")}>
                  ❤️ Follow
                </button>
                <a href="#music" className="button secondary">
                  🎵 Listen
                </a>
              </div>
            </div>
          </div>

          <div className="artist-section-title">
            <h3>🔥 Popular Artists</h3>
            <p>Find your next favorite creator.</p>
          </div>

          <div className="artist-grid">
            {artists.map((artist) => (
              <article className="artist-profile-card" key={artist.id}>
                <div className="artist-card-cover">
                  <div className="artist-avatar-large">🎤</div>
                </div>

                <div className="artist-card-body">
                  <div className="verified-row">
                    <h3>{artist.name}</h3>
                    <span>✓</span>
                  </div>

                  <p className="artist-card-description">
                    {artist.description}
                  </p>

                  <div className="artist-mini-stats">
                    <span>🎵 3 Tracks</span>
                    <span>👥 1K Fans</span>
                  </div>

                  <div className="artist-card-actions">
                    <button
                      onClick={() =>
                        alert(`${artist.name} profile coming soon.`)
                      }
                    >
                      View Profile
                    </button>

                    <button
                      className="follow-small"
                      onClick={() =>
                        alert(`Following ${artist.name} ❤️`)
                      }
                    >
                      ❤️ Follow
                    </button>
                  </div>
                </div>
              </article>
            ))}
          </div>

          <div className="artist-content">
            <div>
              <h3>🎵 Latest Artist Music</h3>
              <p>Fresh releases from AP-STREAM creators.</p>
            </div>

            <div className="artist-content-list">
              <div className="artist-content-item">
                <span>♫</span>
                <div>
                  <strong>Midnight Waves</strong>
                  <small>AP Artist • Music</small>
                </div>
                <a href="#music">▶ Play</a>
              </div>

              <div className="artist-content-item">
                <span>♪</span>
                <div>
                  <strong>African Pulse</strong>
                  <small>African Pulse • Music</small>
                </div>
                <a href="#music">▶ Play</a>
              </div>
            </div>
          </div>

          <div className="artist-creator-banner">
            <div>
              <span>🚀 AP-STREAM FOR CREATORS</span>
              <h3>Build your audience on AP-STREAM.</h3>
              <p>
                Upload music, videos, connect with fans and grow your creator
                profile.
              </p>
            </div>

            <button onClick={() => alert("Creator tools are coming soon.")}>
              Start Creating
            </button>
          </div>
        </section>

        {/* CALLS */}
        <section id="calls" className="calls-section">
          <h2>📞 AP-STREAM Calls</h2>
          <p className="section-subtitle">
            High-quality audio and video calling
          </p>

          <div className="call-options">
            <button
              className="call-button"
              onClick={() => startCall("audio")}
            >
              📞 Audio Call
            </button>

            <button
              className="call-button video-call-button"
              onClick={() => startCall("video")}
            >
              📹 HD Video Call
            </button>
          </div>

          {callError && <p className="call-error">{callError}</p>}

          <div className="call-info">
            <h3>🎥 HD Camera</h3>
            <p>
              AP-STREAM requests up to 1080p video when your device supports it.
            </p>
            <p>🎙️ Noise suppression • 📷 HD video • 🔄 Camera switching</p>
          </div>
        </section>

        <ConnectionsHub />

        <section className="about">
          <h2>🌍 More than music.</h2>
          <p>
            AP-STREAM is being built for music, video, artists,
            creators, community and communication.
          </p>

          <a href="#login" className="button">
            Join AP-STREAM
          </a>
        </section>

        <section id="login" className="login-section">
          <h2>🔐 Login</h2>
          <p>AP-STREAM account login coming soon.</p>
          <button onClick={login}>Login</button>

          {showLoginMessage && (
            <p className="login-message">
              🔐 Login system will be connected to the AP-STREAM account backend.
            </p>
          )}
        </section>
      </main>

      {currentAudio && audioElement && (
        <div className="music-player">
          <div>
            <strong>
              🎵 {musicTracks.find((track) => track.id === currentAudio)?.title}
            </strong>
            <small>
              {" • "}
              {musicTracks.find((track) => track.id === currentAudio)?.artist}
            </small>
          </div>

          <button
            onClick={() => {
              if (audioElement.paused) audioElement.play();
              else audioElement.pause();
              setAudioElement(audioElement);
            }}
          >
            {audioElement.paused ? "▶ Play" : "⏸ Pause"}
          </button>

          <button onClick={stopMusic}>⏹ Stop</button>
        </div>
      )}

      {callOpen && (
        <div className="call-screen">
          {callType === "video" ? (
            <video
              ref={videoRef}
              className="call-video"
              autoPlay
              playsInline
              muted
            />
          ) : (
            <div className="audio-call-screen">
              <div className="call-avatar">👤</div>
              <h2>AP-STREAM Audio Call</h2>
              <p>Microphone connected</p>
            </div>
          )}

          <div className="call-top">
            <span>
              {callType === "video" ? "📹 HD Video Call" : "📞 Audio Call"}
            </span>
          </div>

          <div className="call-controls">
            <button onClick={toggleMic}>
              {micOn ? "🎙️ Mute" : "🔇 Unmute"}
            </button>

            {callType === "video" && (
              <>
                <button onClick={toggleCamera}>
                  {cameraOn ? "📷 Camera Off" : "📷 Camera On"}
                </button>

                <button onClick={switchCamera}>🔄 Switch Camera</button>
              </>
            )}

            <button className="end-call" onClick={endCall}>
              🔴 End Call
            </button>
          </div>
        </div>
      )}

      <AIAssistant />
      <AIAssistantManager />

      <footer>
        © 2026 AP-STREAM • Music • Video • Community • Calls
      </footer>
    </div>
  );
}

export default App;
