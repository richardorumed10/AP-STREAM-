import { useState } from "react";
import "./App.css";

const songs = [
  { name: "Midnight Waves", file: "/music/midnight-waves.mp3" },
  { name: "African Pulse", file: "/music/african-pulse.mp3" },
  { name: "City Lights", file: "/music/city-lights.mp3" },
  { name: "New Generation", file: "/music/new-generation.mp3" },
];

function App() {
  const [currentSong, setCurrentSong] = useState(null);

  return (
    <div className="app">
      <header>
        <h1>AP-STREAM</h1>

        <nav>
          <button>Home</button>
          <button>Music</button>
          <button>Videos</button>
          <button>Artists</button>
          <button>Login</button>
        </nav>
      </header>

      <main>
        <section className="hero">
          <p>MUSIC • VIDEO • COMMUNITY</p>
          <h2>Stream your world.</h2>
          <p>Discover music and artists on AP-STREAM.</p>
        </section>

        <section id="music">
          <h2>🎵 Trending Music</h2>

          <div className="music-grid">
            {songs.map((song) => (
              <div className="music-card" key={song.name}>
                <div className="music-icon">♫</div>

                <h3>{song.name}</h3>
                <p>AP Artist</p>

                <button onClick={() => setCurrentSong(song)}>
                  ▶ Play
                </button>
              </div>
            ))}
          </div>
        </section>

        {currentSong && (
          <div className="player">
            <div className="player-art">♫</div>

            <div className="player-info">
              <span>NOW PLAYING</span>
              <strong>{currentSong.name}</strong>
              <small>AP Artist</small>
            </div>

            <div className="player-actions">
              <button
                onClick={() => {
                  const index = songs.findIndex(
                    (song) => song.name === currentSong.name
                  );
                  const previous =
                    songs[(index - 1 + songs.length) % songs.length];
                  setCurrentSong(previous);
                }}
                aria-label="Previous song"
              >
                ⏮
              </button>

              <button
                onClick={() => {
                  const index = songs.findIndex(
                    (song) => song.name === currentSong.name
                  );
                  const next = songs[(index + 1) % songs.length];
                  setCurrentSong(next);
                }}
                aria-label="Next song"
              >
                ⏭
              </button>
            </div>

            <div className="player-audio">
              <audio controls autoPlay src={currentSong.file}>
                Your browser does not support audio.
              </audio>
            </div>
          </div>
        )}
      </main>

      <footer>© 2026 AP-STREAM</footer>
    </div>
  );
}

export default App;
