  async function startCall(type, liveMode = false) {
    if (type === "video" && !navigator.mediaDevices?.getUserMedia) {
      setCallError(
        "Camera unavailable: this browser/page does not provide camera access."
      );
      return;
    }

    setCallError("");
    setCallType(type);

    try {
      const constraints =
        type === "video"
          ? {
              video: {
                width: { ideal: 1920, min: 1280 },
                height: { ideal: 1080, min: 720 },
                frameRate: { ideal: 30, max: 60 },
                facingMode,
              },
              audio: {
                echoCancellation: true,
                noiseSuppression: true,
                autoGainControl: true,
              },
            }
          : {
              audio: {
                echoCancellation: true,
                noiseSuppression: true,
                autoGainControl: true,
              },
            };

      const stream = await navigator.mediaDevices.getUserMedia(constraints);

      streamRef.current = stream;
      setCallOpen(true);

      if (type === "video" && liveMode) {
        const socket = io(`${window.location.protocol}//${window.location.hostname}:5000`);
        socketRef.current = socket;

        const liveId = "ap-live-" + Date.now();
        liveIdRef.current = liveId;
        setLiveId(liveId);

        socket.on("connect", () => {
          socket.emit("live:create", { liveId });
        });

        socket.on("live:viewer-joined", async ({ viewerId }) => {
          try {
            const peer = new RTCPeerConnection({
              iceServers: [
                { urls: "stun:stun.l.google.com:19302" }
              ]
            });

            peerConnectionsRef.current.set(viewerId, peer);

            stream.getTracks().forEach((track) => {
              peer.addTrack(track, stream);
            });

            peer.onicecandidate = (event) => {
              if (event.candidate) {
                socket.emit("live:signal", {
                  targetId: viewerId,
                  data: {
                    type: "candidate",
                    candidate: event.candidate
                  }
                });
              }
            };

            const offer = await peer.createOffer();
            await peer.setLocalDescription(offer);

            socket.emit("live:signal", {
              targetId: viewerId,
              data: {
                type: "offer",
                offer
              }
            });
          } catch (error) {
            console.error("Live viewer connection failed:", error);
          }
        });

        socket.on("live:signal", async ({ senderId, data }) => {
          const peer = peerConnectionsRef.current.get(senderId);
          if (!peer) return;

          try {
            if (data.type === "answer") {
              await peer.setRemoteDescription(
                new RTCSessionDescription(data.answer)
              );
            }

            if (data.type === "candidate" && data.candidate) {
              await peer.addIceCandidate(
                new RTCIceCandidate(data.candidate)
              );
            }
          } catch (error) {
            console.error("Live signaling error:", error);
          }
        });
      }

      if (type === "video" && videoRef.current) {
        videoRef.current.srcObject = stream;
      }
    } catch (error) {
      console.error("Call permission error:", error);
      setCallError(
        `Camera error: ${error.name || "Unknown"} — ${
          error.message || "Camera or microphone unavailable."
        }`
      );
      setCallOpen(false);
    }
  }

